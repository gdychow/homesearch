# Postgres connection used by Prisma when running the app directly on the
# host (npm run dev / npx prisma ...). Must match POSTGRES_PORT below if
# you change it — the app and migrate containers instead reach postgres
# over the compose network and are unaffected by this port.
DATABASE_URL="postgresql://homealign:homealign@localhost:5432/homealign"

# Used to sign session JWTs — generate with `openssl rand -base64 32`
SESSION_SECRET=""

# Resend API key for invite / password-reset emails
RESEND_API_KEY=""

# Public URL this app is reachable at. Used to build invite/reset links,
# and its scheme controls whether the session cookie is marked Secure
# (only set to an https:// URL once there's a TLS-terminating proxy in front,
# e.g. a Cloudflare Tunnel).
APP_URL="http://localhost:3000"

# Not used by default — cloudflared runs separately on the host, not as
# part of this stack. Only needed if you uncomment the cloudflared service
# in docker-compose.yml to run it here instead.
# CLOUDFLARE_TUNNEL_TOKEN=""

# Compose only — override the defaults baked into docker-compose.yml
POSTGRES_USER=homealign
POSTGRES_PASSWORD=homealign
POSTGRES_DB=homealign

# Host ports the containers are published on — change these if 5432/3000
# are already taken on the host. These only affect the host-side mapping;
# services still talk to each other over the compose network on the
# standard 5432/3000 ports regardless.
POSTGRES_PORT=5432
APP_PORT=3000

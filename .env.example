# Postgres connection used by Prisma
DATABASE_URL="postgresql://homealign:homealign@localhost:5432/homealign"

# Used to sign session JWTs — generate with `openssl rand -base64 32`
SESSION_SECRET=""

# Resend API key for invite / password-reset emails
RESEND_API_KEY=""

# Compose only — override the defaults baked into docker-compose.yml
POSTGRES_USER=homealign
POSTGRES_PASSWORD=homealign
POSTGRES_DB=homealign
